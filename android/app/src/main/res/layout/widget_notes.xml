<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_notes_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingStart="11dp"
    android:paddingTop="10dp"
    android:paddingEnd="11dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/w_notes_open_app"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:padding="4dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_w_note_badge" />

        <TextView
            android:id="@+id/w_notes_group_btn"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_bg"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:singleLine="true"
            android:text="Tất cả nhóm ▾"
            android:textColor="#EDF1F8"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_notes_sort_btn"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/widget_btn_bg"
            android:gravity="center"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"
            android:singleLine="true"
            android:text="⇅ Mới"
            android:textColor="#9AA6BF"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/w_notes_add_btn"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/widget_add_notes_bg"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_w_plus_dark" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/w_notes_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@android:color/transparent"
            android:dividerHeight="6dp"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/w_notes_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="12dp"
            android:text="Chưa có ghi chú"
            android:textColor="#6F7A92"
            android:textSize="12.5sp" />
    </FrameLayout>

</LinearLayout>
