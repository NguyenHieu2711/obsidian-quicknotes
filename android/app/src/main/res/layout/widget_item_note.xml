<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wn_row_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_row_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="11dp"
    android:paddingTop="8dp"
    android:paddingEnd="5dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:id="@+id/wn_body_box"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/wn_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:lineSpacingExtra="1.5dp"
            android:maxLines="2"
            android:textColor="#EDF1F8"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/wn_group_chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_tag_chip_bg"
                android:ellipsize="end"
                android:maxWidth="175dp"
                android:paddingStart="7dp"
                android:paddingTop="2dp"
                android:paddingEnd="7dp"
                android:paddingBottom="2dp"
                android:singleLine="true"
                android:text="+ Gắn nhóm"
                android:textColor="#38BDF8"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/wn_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:singleLine="true"
                android:textColor="#6B768E"
                android:textSize="10.5sp" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/wn_star"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="3dp"
        android:padding="7dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_w_star_off" />

</LinearLayout>
