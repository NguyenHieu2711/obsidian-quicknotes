<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wn_row_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="end"
    android:orientation="horizontal"
    android:paddingStart="42dp"
    android:paddingEnd="0dp">

    <LinearLayout
        android:id="@+id/wn_bubble_box"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_bubble_bg"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="7dp">

        <TextView
            android:id="@+id/wn_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:lineSpacingExtra="1.5dp"
            android:maxLines="3"
            android:textColor="#EDF1F8"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="5dp"
            android:gravity="center_vertical|end"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/wn_group_chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_tag_chip_bg"
                android:ellipsize="end"
                android:maxWidth="155dp"
                android:paddingStart="7dp"
                android:paddingTop="2dp"
                android:paddingEnd="7dp"
                android:paddingBottom="2dp"
                android:singleLine="true"
                android:text="+ Gắn nhóm"
                android:textColor="#38BDF8"
                android:textSize="10sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/wn_star"
                android:layout_width="26dp"
                android:layout_height="22dp"
                android:layout_marginStart="4dp"
                android:paddingStart="5dp"
                android:paddingTop="3dp"
                android:paddingEnd="3dp"
                android:paddingBottom="3dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_w_star_off" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
